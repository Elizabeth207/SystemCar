{{#> layout}}
<div>
  <!-- Encabezado -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div class="flex items-start gap-4">
      <div class="p-3 bg-pink-100 rounded-xl">
        <i class="fa-solid fa-wrench text-pink-500 text-xl"></i>
      </div>
      <div>
        <h2 class="text-2xl md:text-3xl font-bold uppercase flex items-center gap-4 text-gray-800">
          <i class="fa-solid fa-wrench text-3xl md:text-4xl text-pink-600 rounded-full p-3 bg-pink-50"></i>
          <span>Mantenimientos</span>
        </h2>
        <p class="text-gray-500 mt-1">Historial de mantenimientos programados y realizados a la flota</p>
      </div>
    </div>
    <a href="/mantenimientos/add" class="inline-flex items-center gap-2 px-5 py-3 bg-pink-600 text-white rounded-xl hover:bg-pink-700 transition-colors shadow-lg shadow-pink-500/10">
      <i class="fa-solid fa-plus"></i>
      <span>Nuevo Mantenimiento</span>
    </a>
  </div>

  

  {{#if mantenimientos.length}}
  <!-- Tabla -->
  <div class="bg-white rounded-2xl shadow-xl shadow-gray-200/20 overflow-hidden border border-gray-100">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr class="bg-gradient-to-r from-pink-500 to-purple-600">
            <th class="px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider rounded-tl-lg">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-car-side text-white/90"></i>
                <span>Vehículo</span>
              </div>
            </th>
            <th class="px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-calendar text-white/90"></i>
                <span>Fecha</span>
              </div>
            </th>
            <th class="px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-info-circle text-white/90"></i>
                <span>Descripción</span>
              </div>
            </th>
            <th class="px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-money-bill text-white/90"></i>
                <span>Costo</span>
              </div>
            </th>
            <th class="px-6 py-4 text-center text-xs font-medium text-white uppercase tracking-wider rounded-tr-lg">Acciones</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100" id="mantenimientosTableBody">
          {{#each mantenimientos}}
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center gap-2">
                {{{getFieldIcon 'placa'}}}
                <div class="text-sm font-medium text-gray-900">{{this.marca}} {{this.modelo}}</div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center gap-2">
                {{{getFieldIcon 'fecha'}}}
                <div class="text-sm text-gray-600">{{formatDate this.fecha 'DD-MM-YYYY'}}</div>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                {{{getFieldIcon 'descripcion'}}}
                <div class="text-sm text-gray-600">{{this.descripcion}}</div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center gap-2">
                {{{getFieldIcon 'precio'}}}
                <div class="text-sm text-gray-600">{{formatCurrency this.costo}}</div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-center">
              <div class="flex items-center justify-center gap-2">
                <!-- Botón Ver -->
                <button onclick="verDetalles({{json this}})" 
                        class="inline-flex items-center px-3 py-1.5 bg-gray-50 text-gray-700 rounded-lg border border-gray-200 hover:bg-gray-100 transition-colors">
                  <i class="fa-solid fa-eye text-gray-500 mr-1.5"></i>
                  <span>Ver</span>
                </button>
                <!-- Botón Editar -->
                <a href="/mantenimientos/edit/{{this.id}}" 
                   class="inline-flex items-center px-3 py-1.5 bg-pink-50 text-pink-600 rounded-lg border border-pink-100 hover:bg-pink-100 transition-colors">
                  <i class="fa-solid fa-pen text-pink-500 mr-1.5"></i>
                  <span>Editar</span>
                </a>
                <!-- Botón Eliminar -->
                <form action="/mantenimientos/delete/{{this.id}}" method="post" class="inline delete-form" data-name="el mantenimiento de {{this.marca}} {{this.modelo}}">
                  <button type="submit" class="inline-flex items-center px-3 py-1.5 bg-red-50 text-red-600 rounded-lg border border-red-100 hover:bg-red-100 transition-colors">
                    <i class="fa-solid fa-trash text-red-500 mr-1.5"></i>
                    <span>Eliminar</span>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{else}}
    <!-- Estado vacío -->
    <div class="text-center py-12">
      <div class="mb-4">
        <i class="fa-solid fa-wrench text-6xl text-gray-200"></i>
      </div>
      <h3 class="text-lg font-medium text-gray-400">No hay mantenimientos registrados</h3>
      <p class="text-gray-400 mt-1">Comienza agregando un nuevo mantenimiento</p>
    </div>
  {{/if}}
</div>

<!-- Scripts -->
<script>
// (la búsqueda ahora se realiza desde el input global en la navbar)

// Función para mostrar detalles
function verDetalles(mantenimiento) {
  const costo = mantenimiento.costo ? ('S/ ' + Number(mantenimiento.costo).toFixed(2)) : '-';
  Swal.fire({
    showCloseButton: true,
    showConfirmButton: false,
    width: 680,
    html: `
      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="p-6">
          <div class="grid grid-cols-2 gap-6">
            <div class="flex items-start gap-3">
              <i class="fas fa-hashtag text-pink-500 mt-1"></i>
              <div>
                <div class="text-xs text-gray-500">ID Mantenimiento</div>
                <div class="font-medium text-lg mt-1">#${mantenimiento.id || '-'}</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <i class="fas fa-car text-pink-500 mt-1"></i>
              <div>
                <div class="text-xs text-gray-500">Vehículo</div>
                <div class="font-medium text-lg mt-1">${mantenimiento.marca || '-'} ${mantenimiento.modelo || ''}</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <i class="fas fa-calendar-alt text-pink-500 mt-1"></i>
              <div>
                <div class="text-xs text-gray-500">Fecha</div>
                <div class="font-medium text-lg mt-1">${mantenimiento.fecha ? new Date(mantenimiento.fecha).toLocaleDateString('es-ES', {day: '2-digit', month: '2-digit', year: 'numeric'}) : '-'}</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <i class="fas fa-money-bill-wave text-pink-500 mt-1"></i>
              <div>
                <div class="text-xs text-gray-500">Costo</div>
                <div class="font-medium text-lg mt-1">${costo}</div>
              </div>
            </div>
            <div class="flex items-start gap-3 col-span-2">
              <i class="fas fa-clipboard-list text-pink-500 mt-1"></i>
              <div>
                <div class="text-xs text-gray-500">Descripción</div>
                <div class="font-medium text-lg mt-1">${mantenimiento.descripcion || '-'}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    `,
    customClass: { popup: 'rounded-xl' }
  });
}
</script>

<!-- Estilos adicionales -->
<style>
.mantenimiento-modal .swal2-modal {
    padding: 2rem;
}
.mantenimiento-modal .swal2-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1f2937;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1.5rem;
}
</style>
{{/layout}}
