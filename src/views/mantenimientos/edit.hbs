{{#> layout}}
<div class="max-w-2xl mx-auto">
  <!-- Encabezado -->
  <div class="flex items-center gap-4 mb-8">
    <div class="p-3 bg-pink-100 rounded-xl">
      <i class="fa-solid fa-wrench text-pink-500 text-xl"></i>
    </div>
    <div>
      <h2 class="text-2xl font-bold text-gray-800">Editar Mantenimiento</h2>
      <p class="text-gray-500">Actualiza los detalles del mantenimiento del vehículo</p>
    </div>
  </div>

  <!-- Formulario -->
  <div class="bg-white p-8 rounded-2xl shadow-xl shadow-gray-200/20">
  <form action="/mantenimientos/edit/{{mantenimiento.id}}" method="post" class="space-y-6 needs-validate needs-submit-feedback needs-confirm">
      <!-- Vehículo -->
      <div class="form-group">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          <i class="fa-solid fa-car-side text-pink-400 mr-2"></i>Vehículo
        </label>
        <div class="relative">
          <select name="id_vehiculo" required class="w-full px-4 py-3 rounded-xl border-gray-200 focus:border-pink-500 focus:ring focus:ring-pink-500/20 transition-shadow bg-gray-50">
            {{#each vehiculos}}
              <option value="{{this.id}}" {{#ifEquals this.id ../mantenimiento.id_vehiculo}}selected{{/ifEquals}}>
                {{this.marca}} {{this.modelo}}
              </option>
            {{/each}}
          </select>
          <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none">
            <i class="fa-solid fa-chevron-down text-gray-400"></i>
          </div>
        </div>
      </div>

      <!-- Fecha -->
      <div class="form-group">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          <i class="fa-solid fa-calendar text-pink-400 mr-2"></i>Fecha
        </label>
        <div class="relative">
     <input type="date" 
       name="fecha" 
       required
       value="{{mantenimiento.fecha}}" 
       class="w-full px-4 py-3 rounded-xl border-gray-200 focus:border-pink-500 focus:ring focus:ring-pink-500/20 transition-shadow bg-gray-50" />
        </div>
      </div>

      <!-- Descripción -->
      <div class="form-group">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          <i class="fa-solid fa-clipboard text-pink-400 mr-2"></i>Descripción
        </label>
  <textarea name="descripcion" 
      rows="3" required
      class="w-full px-4 py-3 rounded-xl border-gray-200 focus:border-pink-500 focus:ring focus:ring-pink-500/20 transition-shadow bg-gray-50">{{mantenimiento.descripcion}}</textarea>
      </div>

      <!-- Costo -->
      <div class="form-group">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          <i class="fa-solid fa-money-bill text-pink-400 mr-2"></i>Costo
        </label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500">S/</span>
     <input name="costo" 
       type="number" 
       step="0.01" required
       value="{{mantenimiento.costo}}" 
       class="w-full pl-10 pr-4 py-3 rounded-xl border-gray-200 focus:border-pink-500 focus:ring focus:ring-pink-500/20 transition-shadow bg-gray-50" />
        </div>
      </div>

      <!-- Botones -->
      <div class="flex items-center gap-3 pt-4">
        <button type="submit" class="px-6 py-3 bg-pink-600 text-white rounded-xl hover:bg-pink-700 transition-colors flex items-center gap-2">
          <i class="fa-solid fa-save"></i>
          <span>Guardar Cambios</span>
        </button>
        <a href="/mantenimientos" class="px-6 py-3 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition-colors flex items-center gap-2">
          <i class="fa-solid fa-times"></i>
          <span>Cancelar</span>
        </a>
      </div>
    </form>
  </div>
</div>
{{/layout}}
