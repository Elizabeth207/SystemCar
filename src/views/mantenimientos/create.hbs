{{#> layout}}
<div class="form-card bg-white p-6 rounded-lg shadow max-w-lg">
  <h2 class="text-xl font-bold mb-1 flex items-center gap-3"><i class="fa-solid fa-screwdriver-wrench text-indigo-600"></i> Registrar Mantenimiento</h2>
  <p class="text-sm text-gray-500 mb-4">Programa un nuevo mantenimiento para un vehículo.</p>
  <form action="/mantenimientos/add" method="post" class="space-y-4 needs-validate needs-submit-feedback needs-confirm">
    <div>
      <label class="block text-sm font-medium text-gray-700">Vehículo</label>
      <select name="id_vehiculo" required class="w-full border border-gray-200 px-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100">
        {{#each vehiculos}}<option value="{{this.id}}">{{this.marca}} {{this.modelo}}</option>{{/each}}
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Fecha</label>
  <input type="date" name="fecha" required class="w-full border border-gray-200 px-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Descripción</label>
  <input name="descripcion" required class="w-full border border-gray-200 px-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100" placeholder="Ej: Cambio de aceite" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Costo</label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">S/</span>
  <input name="costo" type="number" step="0.01" required class="w-full border border-gray-200 pl-8 pr-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100" />
      </div>
    </div>
    <div class="flex items-center gap-3">
  <button type="submit" class="btn-accent inline-flex items-center gap-2 px-4 py-2 rounded font-semibold"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
      <a href="/mantenimientos" class="inline-flex items-center gap-2 px-4 py-2 rounded border text-gray-600"><i class="fa-solid fa-ban"></i> Cancelar</a>
    </div>
  </form>
</div>
{{/layout}}
