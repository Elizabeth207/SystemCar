{{#> layout}}
<div class="max-w-2xl mx-auto">
  <div class="bg-white rounded-2xl shadow-lg border border-gray-100">
    <div class="bg-gradient-to-r from-pink-500 to-purple-600 rounded-t-2xl p-6 text-white">
      <h2 class="text-2xl md:text-3xl font-bold flex items-center gap-3">
        <i class="fa-solid fa-calendar-days text-3xl"></i>
        Editar Alquiler
      </h2>
      <p class="text-pink-100 mt-2">Modifica fechas, responsable y estado del alquiler.</p>
    </div>

    <div class="p-6">
      <form action="/alquileres/edit/{{alquiler.id}}" method="post" class="space-y-6 needs-validate needs-submit-feedback needs-confirm">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Vehículo</label>
            <select name="id_vehiculo" required class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100">
              {{#each vehiculos}}<option value="{{this.id}}" {{#ifEquals this.id ../alquiler.id_vehiculo}}selected{{/ifEquals}}>{{this.marca}} {{this.modelo}}</option>{{/each}}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Cliente</label>
            <select name="id_cliente" required class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100">
              {{#each clientes}}<option value="{{this.id}}" {{#ifEquals this.id ../alquiler.id_cliente}}selected{{/ifEquals}}>{{this.nombre}}</option>{{/each}}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Empleado</label>
            <select name="id_empleado" class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100">
              {{#each empleados}}<option value="{{this.id}}" {{#ifEquals this.id ../alquiler.id_empleado}}selected{{/ifEquals}}>{{this.nombre}}</option>{{/each}}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Fecha inicio</label>
            <input type="date" name="fecha_inicio" value="{{alquiler.fecha_inicio}}" required class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Fecha fin</label>
            <input type="date" name="fecha_fin" value="{{alquiler.fecha_fin}}" required class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Total</label>
            <input name="total" type="number" step="0.01" value="{{alquiler.total}}" class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Estado</label>
            <select name="estado" required class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100">
              <option value="activo" {{#ifEquals alquiler.estado "activo"}}selected{{/ifEquals}}>Activo</option>
              <option value="finalizado" {{#ifEquals alquiler.estado "finalizado"}}selected{{/ifEquals}}>Finalizado</option>
              <option value="cancelado" {{#ifEquals alquiler.estado "cancelado"}}selected{{/ifEquals}}>Cancelado</option>
            </select>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-4 border-t">
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-medium bg-gradient-to-r from-pink-600 to-purple-600 text-white hover:from-pink-700 hover:to-purple-700 shadow transition">
            <i class="fa-solid fa-floppy-disk"></i> Guardar cambios
          </button>
          <a href="/alquileres" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">Cancelar</a>
        </div>
      </form>
    </div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('input, select, textarea').forEach(el => el.classList.add('form-input'));
    document.querySelectorAll('label').forEach(el => el.classList.add('form-label'));
  });
  </script>
</div>

{{/layout}}
