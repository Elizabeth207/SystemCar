{{#> layout}}
<div class="form-card bg-white p-6 rounded-lg shadow max-w-2xl">
  <h2 class="text-xl font-bold mb-1 flex items-center gap-3"><i class="fa-solid fa-calendar-days text-indigo-600"></i> Nuevo Alquiler</h2>
  <p class="text-sm text-gray-500 mb-4">Registra un nuevo contrato de alquiler completando todos los campos.</p>
  <form action="/alquileres/add" method="post" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Vehículo</label>
        <select name="id_vehiculo" required class="w-full border border-gray-200 px-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100">
          {{#each vehiculos}}<option value="{{this.id}}">{{this.marca}} {{this.modelo}}</option>{{/each}}
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Cliente</label>
        <select name="id_cliente" required class="w-full border border-gray-200 px-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100">
          {{#each clientes}}<option value="{{this.id}}">{{this.nombre}}</option>{{/each}}
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Empleado</label>
        <select name="id_empleado" class="w-full border border-gray-200 px-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100">
          {{#each empleados}}<option value="{{this.id}}">{{this.nombre}}</option>{{/each}}
        </select>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Fecha inicio</label>
        <div class="relative">
          <i class="fa-solid fa-calendar absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <input type="date" name="fecha_inicio" required class="w-full border border-gray-200 pl-10 pr-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Fecha fin</label>
        <div class="relative">
          <i class="fa-solid fa-calendar absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <input type="date" name="fecha_fin" required class="w-full border border-gray-200 pl-10 pr-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100" />
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Total</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">S/</span>
          <input name="total" type="number" step="0.01" class="w-full border border-gray-200 pl-8 pr-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Estado</label>
        <select name="estado" class="w-full border border-gray-200 px-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-100">
          <option value="activo">🟢 Activo</option>
          <option value="finalizado">✓ Finalizado</option>
          <option value="cancelado">❌ Cancelado</option>
        </select>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <button class="btn-accent inline-flex items-center gap-2 px-4 py-2 rounded font-semibold"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
      <a href="/alquileres" class="inline-flex items-center gap-2 px-4 py-2 rounded border text-gray-600"><i class="fa-solid fa-ban"></i> Cancelar</a>
    </div>
  </form>
</div>
{{/layout}}
