{{#> layout}}
<div class="max-w-lg mx-auto">
  <div class="bg-white rounded-2xl shadow-lg border border-gray-100">
    <div class="bg-gradient-to-r from-pink-500 to-purple-600 rounded-t-2xl p-6 text-white">
      <h2 class="text-2xl font-bold flex items-center gap-3">
        <i class="fa-solid fa-tags text-3xl"></i>
        Editar Categoría
      </h2>
      <p class="text-pink-100 mt-2">Actualiza la información de la categoría.</p>
    </div>

    <div class="p-6">
      <form action="/categorias/edit/{{categoria.id}}" method="post" class="space-y-4 needs-validate needs-submit-feedback needs-confirm">
        <div>
          <label class="block text-sm font-medium text-gray-700">Nombre</label>
          <input name="nombre" required value="{{categoria.nombre}}" class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Descripción</label>
          <textarea name="descripcion" required class="w-full border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-100">{{categoria.descripcion}}</textarea>
        </div>

        <div class="flex items-center gap-3 pt-4 border-t">
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-medium bg-gradient-to-r from-pink-600 to-purple-600 text-white hover:from-pink-700 hover:to-purple-700 shadow transition"><i class="fa-solid fa-floppy-disk"></i> Actualizar</button>
          <a href="/categorias" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">Cancelar</a>
        </div>
      </form>
    </div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('input, select, textarea').forEach(el => el.classList.add('form-input'));
    document.querySelectorAll('label').forEach(el => el.classList.add('form-label'));
  });
  </script>
</div>
{{/layout}}
