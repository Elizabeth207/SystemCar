{{#> layout}}
<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-2xl font-bold flex items-center gap-3"><i class="fa-solid fa-user text-indigo-600 rounded-full p-2 bg-indigo-50"></i> Ver cliente</h2>
      <p class="text-sm text-gray-500 mt-1">Detalles del cliente</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/clientes" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg border border-gray-200">← Volver</a>
      <a href="/clientes/edit/{{cliente.id}}" class="px-4 py-2 bg-gradient-to-r from-pink-500 to-purple-600 text-white rounded-lg">Editar</a>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow p-6 border border-gray-100">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <h3 class="text-xs text-gray-400 uppercase">Nombre</h3>
        <p class="mt-1 text-lg font-medium text-gray-900">{{cliente.nombre}}</p>
      </div>
      <div>
        <h3 class="text-xs text-gray-400 uppercase">DNI</h3>
        <p class="mt-1 text-lg text-gray-700">{{cliente.dni}}</p>
      </div>
      <div>
        <h3 class="text-xs text-gray-400 uppercase">Teléfono</h3>
        <p class="mt-1 text-lg text-gray-700">{{cliente.telefono}}</p>
      </div>
      <div>
        <h3 class="text-xs text-gray-400 uppercase">Correo</h3>
        <p class="mt-1 text-lg text-gray-700">{{cliente.correo}}</p>
      </div>
      <div class="sm:col-span-2">
        <h3 class="text-xs text-gray-400 uppercase">Dirección</h3>
        <p class="mt-1 text-gray-700">{{cliente.direccion}}</p>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3">
      <form action="/clientes/delete/{{cliente.id}}" method="post" class="inline delete-form" data-name="{{cliente.nombre}}">
        <button type="submit" class="px-4 py-2 bg-red-50 text-red-600 rounded-lg border border-red-100">Eliminar</button>
      </form>
    </div>
  </div>
</div>
{{/layout}}
